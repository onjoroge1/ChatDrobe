# SERVER settings only. Set actual values in Vercel, never in this file or an extension.
BILLING_MODE=off
BILLING_ORIGIN=https://www.chatdrobe.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional direct endpoint for the SAME database when runtime uses a pooler:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# BILLING_DATABASE_URL remains a legacy fallback only. Avoid conflicting duplicate values.
STRIPE_SECRET_KEY=REPLACE_WITH_TEST_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_TEST_ENDPOINT_SECRET
STRIPE_PLUS_PRICE_ID=REPLACE_WITH_TEST_ANNUAL_PRICE
BILLING_SIGNING_PRIVATE_KEY=REPLACE_WITH_P256_PKCS8_PEM
BILLING_EXTENSION_IDS=

# Public email-code sign-in. Verify chatdrobe.com in Resend before enabling.
# These server-only settings are independent of owner login and Stripe.
AUTH_ORIGIN=https://www.chatdrobe.com
AUTH_EMAIL_FROM="ChatDrobe <login@chatdrobe.com>"
RESEND_API_KEY=REPLACE_WITH_DOMAIN_SCOPED_SENDING_KEY
