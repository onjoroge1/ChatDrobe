# Private server environment only. Never copy these credentials into the extension.
BILLING_MODE=off
BILLING_ORIGIN=https://YOUR-APP.vercel.app
BILLING_DATABASE_URL=postgresql://REPLACE_IN_SECRET_SETTINGS
STRIPE_SECRET_KEY=REPLACE_WITH_TEST_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_TEST_ENDPOINT_SECRET
STRIPE_PLUS_PRICE_ID=REPLACE_WITH_TEST_ANNUAL_PRICE
BILLING_SIGNING_PRIVATE_KEY=REPLACE_WITH_P256_PKCS8_PEM
# Installed unpacked extension ID(s), comma-separated. Public identifiers, not credentials.
BILLING_EXTENSION_IDS=
