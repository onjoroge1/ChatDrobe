{
  "name": "chatdrobe-website",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Independent, static ChatDrobe companion website. No extension runtime code.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test"
  }
}
