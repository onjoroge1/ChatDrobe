{
  "name": "chatdrobe-website",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "ChatDrobe extension, companion website and isolated test billing API.",
  "engines": {"node": "22.x"},
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:vercel": "node scripts/build.mjs && node scripts/build-vercel.mjs && npm run db:deploy",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "build:extension": "npm --prefix browser-extension run build",
    "test:extension": "npm --prefix browser-extension test",
    "check:extension": "npm --prefix browser-extension run check",
    "check:all": "npm run check && npm run check:extension && npm run test:billing",
    "package:extension": "npm run check:extension && python3 scripts/package-extension.py",
    "install:billing": "npm --prefix server ci --ignore-scripts",
    "test:billing": "npm --prefix server test",
    "db:migrate": "node server/migrate.mjs",
    "db:status": "node server/database-status.mjs",
    "db:deploy": "node server/deploy-database.mjs"
  }
}
